# OPENROUTER_API_KEY: Required for OpenRouter AI models.
OPENROUTER_API_KEY=

# OPENROUTER_MODEL: Optional. The OpenRouter model to use (default: google/gemini-flash-1.5)
OPENROUTER_MODEL=

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT=gen-lang-client-0871747406
GOOGLE_CLOUD_LOCATION=us-central1

# VERTEX_DATA_STORE_ID: The ID of your Vertex AI Search Data Store.
# When configured, queries are grounded with live documents from your Google Cloud Agent Builder.
VERTEX_DATA_STORE_ID=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ELEVENLABS_API_KEY: Required for ElevenLabs Text-to-Speech integration.
ELEVENLABS_API_KEY=

# ELEVENLABS_VOICE_ID: Optional. Add the Voice ID of your custom Emberlynn voice here.
ELEVENLABS_VOICE_ID=
