# OPENROUTER_API_KEY: Required. This is the only key most people need - it
# covers both chat/vision (gpt-5-nano by default, cheap) AND Ada's voice
# (gpt-audio-mini) through one account. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# OPENROUTER_MODEL: Optional. Defaults to openai/gpt-5-nano.
OPENROUTER_MODEL=

# GEMINI_API_KEY: Optional. Only needed if you want Ada's chat to fall back
# to Google's API directly (its own separate free-tier quota) when
# OpenRouter is unavailable. Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# APP_URL: The URL this app is deployed at (used as the OpenRouter HTTP-Referer header).
APP_URL="https://youglowgirl.app"

# --- Everything below is optional. Ada's voice already works via OpenRouter
# (gpt-audio-mini) above. These are only used as a fallback if that fails or
# OPENROUTER_API_KEY isn't set. ---

# ELEVENLABS_API_KEY: Optional TTS fallback.
ELEVENLABS_API_KEY=

# ELEVENLABS_VOICE_ID: Optional. Defaults to ElevenLabs' public "Rachel" voice.
ELEVENLABS_VOICE_ID=

# HF_API_KEY: Optional. Hugging Face token for the Inference API (last-resort TTS fallback).
HF_API_KEY=
